{
  "expo": {
    "name": "Shift Scheduler",
    "slug": "shift-scheduler",
    "scheme": "shifts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1116"
    },
    "ios": {
      "supportsTablet": true
    },
      "android": {
        "package": "com.example.shiftscheduler",
        "permissions": [
          "VIBRATE",
          "WAKE_LOCK",
          "SCHEDULE_EXACT_ALARM",
          "RECEIVE_BOOT_COMPLETED",
          "POST_NOTIFICATIONS"
        ]
      },
          "plugins": [
        [
          "expo-notifications",
          {
            "androidMode": "default"
          }
        ],
        "expo-router"
      ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "918b39fb-e366-4618-9823-26f58f430658"
      }
    },
    "owner": "maxsur"
  }
}
